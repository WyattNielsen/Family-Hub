# The public URL where Family Hub is accessible (used for Google OAuth redirects and WebRTC ICE host)
# Use your local IP for local-only access, or your Nabu Casa / ngrok URL for remote access
APP_BASE_URL=http://192.168.1.100:3000

# Port the app listens on (LXC/native install only; default 3000)
PORT=3000

# PostgreSQL connection URL (optional override; Docker Compose and LXC set sensible defaults)
# DATABASE_URL=postgresql://familyhub:familyhub@postgres:5432/familyhub

# go2rtc API URL for WebRTC camera streaming (optional override; Docker Compose and LXC set defaults)
# GO2RTC_URL=http://go2rtc:1984

# Google OAuth credentials — from Google Cloud Console
# See README.md for setup instructions
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Shared secret for tools/google-oauth-local (required to import tokens from your PC).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_IMPORT_SECRET=
